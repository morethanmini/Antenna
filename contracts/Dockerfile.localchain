# 로컬 개발 체인 (ANT-CHAIN-15) — docker-compose.override.yml 의 chain 서비스가 쓴다. 운영 배포에는 들어가지 않는다.
#
# 이미지 안에서 컴파일까지 끝내 둔다 — 컨테이너가 뜰 때마다 solc 를 받거나 컴파일하지 않게.
# 컨트랙트(.sol)나 스크립트를 고치면 `docker compose up -d --build chain` 으로 다시 굽는다.
FROM node:22-alpine

WORKDIR /app

# Hardhat 이 처음 돌 때 묻는 사용 통계 동의를 건너뛴다(대화형 입력이 없는 컨테이너라 멈출 수 있다).
ENV HARDHAT_DISABLE_TELEMETRY_PROMPT=true

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY hardhat.config.js ./
COPY contracts ./contracts
COPY scripts ./scripts
RUN npx hardhat compile

EXPOSE 8545
CMD ["node", "scripts/localchain-start.mjs"]
